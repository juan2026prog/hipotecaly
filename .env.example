# HIPOTECALY Environment Variables Example
# NO ingresar secretos ni service_role keys en este archivo.
# En desarrollo local con Supabase CLI, los valores por defecto suelen ser:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=tu-anon-key-local

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# SITEOS UNIVERSAL IDENTITY & KYC (Didit API v3 / Mock / Sandbox / Live)
# ------------------------------------------------------------------------------
KYC_PROVIDER=didit # 'mock' | 'didit'
KYC_MODE=mock # 'mock' | 'sandbox' | 'live'
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_URL=
DIDIT_CALLBACK_URL=
DIDIT_URUGUAY_DNIC_ENABLED=false

# ------------------------------------------------------------------------------
# SITEOS UNIVERSAL DIGITAL SIGNATURE (Firma.gub.uy / AGESIC / Mock)
# ------------------------------------------------------------------------------
SIGNATURE_PROVIDER=mock # 'mock' | 'firma_gub'
SIGNATURE_MODE=mock # 'mock' | 'test' | 'live'
FIRMA_GUB_API_BASE_URL= # Gateway / API Manager para REST endpoints
FIRMA_GUB_SIGN_BASE_URL= # Host portal ciudadano para /es/pp/firmar
FIRMA_GUB_API_PREFIX=/api/v1/externos # Configurable: /api/v1/externos o /api/externos
FIRMA_GUB_STATUS_METHOD=GET # 'GET' | 'HEAD'
FIRMA_GUB_PROCESS2_TRANSPORT=multipart # 'multipart' | 'binary'
FIRMA_GUB_RETURN_URL=https://hipotecaly.vercel.app/signature/return
FIRMA_GUB_NOTIFICATION_URL=https://hipotecaly.vercel.app/api/integrations/signature/firma-gub/webhook

# AGESIC API Manager Gateway Auth (Opcional - Server-side only)
FIRMA_GUB_API_MANAGER_AUTH_MODE=none # 'none' | 'bearer' | 'oauth2_client_credentials'
FIRMA_GUB_API_MANAGER_TOKEN_URL=
FIRMA_GUB_API_MANAGER_CLIENT_ID=
FIRMA_GUB_API_MANAGER_CLIENT_SECRET=
FIRMA_GUB_API_MANAGER_SCOPE=
FIRMA_GUB_API_MANAGER_BEARER_TOKEN=
